   "source": [
    "def add(a, b):\n",
    "    add = a + b\n",
    "    return add\n",
    "\n",
    "def sum_list(values):\n",
    "    total = 0\n",
    "    for value in values:\n",
    "        total = add(total, value)\n",
    "    return total\n",
    "\n",
    "print(add(2, 3))\n",
    "print(add(4, 5))\n",
    "print(add(6, 1))\n",
    "print(sum_list([1, 2, 3, 4, 5]))"
   ]
  },
