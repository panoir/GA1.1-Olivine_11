   "source": [
    "def subtract(a, b):\n",
    "    return (a - b)\n",
    "\n",
    "def distance_from_zero(x):\n",
    "    if x < 0:\n",
    "        return -x\n",
    "    else:\n",
    "        return x\n",
    "result = subtract(5, 10)\n",
    "print(result)\n",
    "\n",
    "distance = distance_from_zero(result)\n",
    "\n",
    "print(distance)\n"
   ]
